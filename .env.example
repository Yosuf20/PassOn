# PassOn — Environment Variables
# Copy this to .env and fill in your values

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api
VITE_MOCK_MODE=true

# Backend (local dev server)
BACKEND_PORT=3001

# Groq AI (vision analysis)
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# AWS (for backend deployment — not yet integrated)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
STAGE=dev

# Cognito (not yet integrated)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 (not yet integrated)
S3_UPLOADS_BUCKET=

# Bedrock (not yet integrated — placeholder for future provider)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# SES (not yet integrated)
SES_FROM_EMAIL=
